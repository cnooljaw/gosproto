{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ],
    "rootDir": "typescript",
    "outDir": "dist"
  },
  "include": [
    "typescript/**/*.ts"
  ]
}
